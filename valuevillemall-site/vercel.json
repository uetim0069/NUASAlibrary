{
 "cleanUrls": true,
 "trailingSlash": false,
 "redirects": [
  {
   "source": "/supplier-signup",
   "destination": "/supplier",
   "permanent": false
  },
  {
   "source": "/live-testing",
   "destination": "/track",
   "permanent": true
  },
  {
   "source": "/live-testing-tracking",
   "destination": "/track",
   "permanent": true
  },
  {
   "source": "/account",
   "destination": "/cart",
   "permanent": false
  }
 ],
 "headers": [
  {
   "source": "/img/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  }
 ],
 "rewrites": [
  {
   "source": "/supa/:path*",
   "destination": "https://asgboqvwrbeaeylexryt.supabase.co/:path*"
  }
 ]
}